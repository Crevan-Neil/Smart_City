# ─────────────────────────────────────────────
#  SMART CITY DIGITAL TWIN — .env.example
#  Copy this file to .env and fill in values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────
MONGO_USER=admin
MONGO_PASS=citypass

# ── InfluxDB ──────────────────────────────────
INFLUX_USER=admin
INFLUX_PASS=citypass123
INFLUX_ORG=smart_city_org
INFLUX_BUCKET=city_sensors
INFLUX_TOKEN=my-super-secret-token     # change this before any real deployment

# ── AI / LLM ──────────────────────────────────
LLM_API_KEY=your_gemini_or_openai_key_here
LLM_MODEL=gemini-3-flash-preview             # or gpt-4o-mini

# ── Simulation ────────────────────────────────
SIM_INTERVAL_SEC=2                     # how often the sim generates new values

# ── Redis ─────────────────────────────────────
# No password by default for local dev.
# Add: redis-server --requirepass yourpass  if needed.

# ── Frontend (Vite exposes VITE_ vars only) ───
VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001
VITE_AI_URL=http://localhost:8001
